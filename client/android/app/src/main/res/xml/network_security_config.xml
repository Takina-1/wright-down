<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 注意：本文件只对 Android 原生网络栈（OkHttp / HttpsURLConnection / WebView）
         生效。Flutter 的 dart:io 网络栈不读它，直接读 /system/etc/security/cacerts。
         云端经 Cloudflare 代理，Cloudflare 用公网 CA 签发证书，系统信任库已覆盖，
         无需在此追加自签 CA（历史实现曾用 @raw/diary_ca，见设计文档）。 -->
    <!-- 生产环境全程禁明文；信任系统 CA 信任库 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 安卓模拟器访问宿主机的别名，仅开发用 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
