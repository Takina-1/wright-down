[Unit]
Description=F013 云同步服务端 (Dart shelf)
Documentation=file:///opt/diary-sync/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=diary
Group=diary
WorkingDirectory=/opt/diary-sync
EnvironmentFile=/etc/diary-sync/pg.env
Environment=DART_SDK=/opt/dart-sdk
Environment=PUB_HOSTED_URL=https://pub.flutter-io.cn
Environment=FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn
ExecStart=/opt/diary-sync/server
Restart=on-failure
RestartSec=5
# 日记内容属于用户隐私，限制服务自身能看到的东西
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/diary-sync

[Install]
WantedBy=multi-user.target
