[Unit]
Description=F013 云同步服务端 (Dart shelf)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=diary
Group=diary
WorkingDirectory=/opt/diary-sync
EnvironmentFile=-/etc/diary-sync/server.env
# COS credentials (COS_BUCKET/COS_SECRET_ID/COS_SECRET_KEY/COS_PREFIX).
# NOTE: this comment must be a standalone line -- a trailing inline comment
# on the EnvironmentFile line made systemd silently skip loading cos.env
# (observed on this host; unit file comments stay ASCII-only).
EnvironmentFile=-/etc/diary-sync/cos.env
# PostgreSQL credentials (PG_HOST/PG_PORT/PG_DB/PG_USER/PG_PASSWORD).
# NOTE: keep comment lines standalone/ASCII -- an inline comment on the
# EnvironmentFile line made systemd silently skip loading cos.env (observed
# on this host); the same trap applies here.
EnvironmentFile=-/etc/diary-sync/pg.env
ExecStart=/opt/diary-sync/bin/server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/diary-sync

[Install]
WantedBy=multi-user.target
